{
  "expo": {
    "name": "smartroute",
    "slug": "smartroute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartroute",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Izinkan SmartRoute mengakses lokasi Anda untuk navigasi."
      },
      "icon": "./assets/expo.icon"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.inouerakan.smartroute"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan SmartRoute mengakses lokasi Anda untuk navigasi"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001C43",
          "image": "./assets/splash/splash-background.png",
          "resizeMode": "cover"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1784284-6bc1-4153-bc60-fcc177840d0a"
      }
    },
    "owner": "lippbytes-team"
  }
}
