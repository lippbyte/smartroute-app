# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real API keys.

# Required for POST /assistant/ask (Task Backend-06). Get one at
# https://openrouter.ai (free account, then create a key on the dashboard).
OPENROUTER_API_KEY= 

# Model yang DIPAKAI PRODUKSI dan yang menjadi dasar seluruh verifikasi
# asisten (dipilih langsung oleh user, 2026-09-10). Tanpa baris ini backend
# jatuh ke default kode (anthropic/claude-haiku-4.5): tidak error, tapi model
# yang berbeda dan belum diuji — terukur ~7x lebih lambat pada pertanyaan yang
# sama. Batas token reasoning di openRouterClient.ts juga disetel untuk model
# ini. Ganti hanya dengan menguji ulang asisten.
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Optional — overrides the default port (3000).
# PORT=3000

# Optional — overrides the OTP2 GraphQL endpoint (default assumes the local
# docker-compose setup from otp2-setup/).
# OTP2_URL=http://localhost:8080/otp/gtfs/v1

# Optional — overrides the path to the static GTFS zip used for headway
# lookup (Task Backend-05) and the assistant's route list (Task Backend-06).
# GTFS_ZIP_PATH=../otp2-setup/data/transjakarta_gtfs.zip

# Hari 1 (akun, riwayat, rating). Keduanya opsional.
# Lokasi file SQLite (default: data/smartroute.db, di-gitignore — berisi hash
# password dan data pribadi, jangan di-commit).
# DB_PATH=data/smartroute.db
# Masa berlaku token sesi dalam jam (default: 168 = 7 hari). Token adalah
# string acak yang disimpan sebagai hash SHA-256 (bukan JWT), jadi TIDAK ada
# rahasia penandatangan yang perlu diisi di sini.
# SESSION_TTL_HOURS=168

# Hari 1 Task 4: batas pemakaian TOTO (POST /assistant/ask wajib masuk).
# Maks. pertanyaan per pengguna per 60 menit bergulir (default 30).
TOTO_HOURLY_LIMIT=30
# Akun demo presentasi (dipisah koma) memakai batas per jam yang lebih tinggi.
TOTO_DEMO_EMAILS=demo@smartroute.test
TOTO_DEMO_HOURLY_LIMIT=100
# Maks. pertanyaan untuk SEMUA pengguna per hari kalender WIB (default 300).
TOTO_DAILY_CAP=300
# Ketiga batas di atas bisa dinaikkan TANPA restart/deploy ulang: tulis file
# data/toto-limits.json (folder yang sama dengan database), mis.
#   { "daily_cap": 500, "hourly_limit": 40, "demo_hourly_limit": 150 }
# File dibaca ulang tiap permintaan dan menimpa nilai di sini; hapus file
# untuk kembali ke nilai .env.

# HANYA UNTUK UJI: arahkan panggilan LLM ke provider tiruan lokal
# (scripts/test-toto-privacy.mjs). Jangan diisi di demo/produksi — API key
# OpenRouter ikut terkirim ke URL ini.
# OPENROUTER_URL=
